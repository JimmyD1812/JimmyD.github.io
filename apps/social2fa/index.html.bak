<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shared Secret Social 2FA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background: #0b0d11;
            background: radial-gradient(circle at 50% -20%, #1c2336, #0b0d11);
            color: #f0f2f5;
        }

        .card {
          background-color: #131722;
          border: 1px solid #222838;
          border-radius: 16px;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .input-field {
            background-color: #1c2030;
            border: 1px solid #222838;
            color: white;
            transition: all 0.2s ease;
        }

        .input-field:focus {
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        .word-card {
            background-color: #0d1017;
            border: 1px solid #222838;
            transition: transform 0.2s ease;
        }

        .word-card:active {
            transform: scale(0.98);
        }

        .progress-bar {
            height: 6px;
            background-color: #4e5058;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background-color: #5865f2;
            transition: width 1s linear;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .sync-dot {
            animation: pulse 3s infinite;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">

    <div class="w-full max-w-md card p-8">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-extrabold text-white mb-2">Social 2FA</h1>
            <p class="text-sm text-gray-400">Verifying identity via shared secrets</p>
        </div>

        <div class="space-y-8">
            <!-- Secret Passphrase Input -->
            <div>
                <label for="passphrase" class="block text-xs font-bold uppercase text-gray-400 mb-2 tracking-wider">Secret Passphrase</label>
                <div class="relative">
                    <input type="password" id="passphrase" placeholder="Enter shared secret..." 
                           class="w-full p-4 pr-12 rounded-lg input-field font-semibold text-lg">
                    <button id="toggleVisible" type="button" class="absolute right-3 top-1/2 -translate-y-1/2 p-2 text-gray-400 hover:text-white focus:outline-none transition-colors select-none">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <p class="mt-2 text-[11px] text-gray-500 italic">Caps and spaces are ignored. Enter the secret known only to you and your friend.</p>
            </div>

            <!-- Verification Display -->
            <div id="authPanel" class="hidden space-y-6">
                <div class="grid grid-cols-1 gap-4">
                    <div class="word-card p-5 rounded-xl border-l-4 border-indigo-500">
                        <p class="text-xs uppercase font-bold text-indigo-400 mb-2">Challenge (You say)</p>
                        <p id="challengeWord" class="text-3xl font-black text-white uppercase tracking-tighter">...</p>
                    </div>

                    <div class="word-card p-5 rounded-xl border-l-4 border-emerald-500">
                        <p class="text-xs uppercase font-bold text-emerald-400 mb-2">Response (They reply)</p>
                        <p id="responseWord" class="text-3xl font-black text-white uppercase tracking-tighter">...</p>
                    </div>
                </div>

                <!-- 15-Minute Timer -->
                <div class="pt-6">
                    <div class="flex justify-between items-end mb-3">
                        <div>
                            <span class="text-xs font-bold text-gray-500 uppercase block mb-1">Rotating in</span>
                            <span id="timerText" class="text-xl font-mono font-bold text-white">15:00</span>
                        </div>
                        <div class="flex items-center gap-2 pb-1">
                            <span class="text-[10px] font-bold text-gray-500 uppercase">Live Sync</span>
                            <div class="w-2 h-2 rounded-full bg-indigo-500 sync-dot"></div>
                        </div>
                    </div>
                    <div class="progress-bar">
                        <div id="progressBar" class="progress-fill" style="width: 100%"></div>
                    </div>
                </div>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-12 border-2 border-dashed border-gray-700 rounded-xl">
                <div class="text-4xl mb-4 opacity-30">🛡️</div>
                <p class="text-gray-500 font-medium">Enter the passphrase to begin</p>
            </div>
        </div>

        <div class="mt-12 pt-6 border-t border-gray-700/50 text-center">
            <p class="text-[10px] text-gray-600 leading-relaxed uppercase tracking-widest font-bold">
                Protocol: Time-Synced Hash (15m Epoch)
            </p>
        </div>
    </div>

    <script>
        const INTERVAL_MS = 15 * 60 * 1000;
        
        const words = [
            "PINEAPPLE", "ORCHESTRA", "SUBMARINE", "VELOCITY", "ECLIPSE", "HORIZON", "NEBULA", 
            "LABYRINTH", "SAPPHIRE", "ACOUSTIC", "PARADOX", "WILDERNESS", "SYMPHONY", "OBSIDIAN",
            "MONARCH", "GLACIER", "VOYAGER", "EMBER", "CIPHER", "SUMMIT", "ZENITH", "QUASAR",
            "FALCON", "HARBOR", "CANVAS", "MIRAGE", "TUNDRA", "CASCADE", "RADIANCE", "VERTEX",
            "BONSAI", "PEBBLE", "LANTERN", "COMPASS", "MOSAIC", "GRANITE", "AURORA", "WILLOW",
            "MANTIS", "THUNDER", "ROCKET", "ANCHOR", "BREEZE", "CACTUS", "DIAMOND", "EAGLE",
            "FOREST", "GRAVEL", "HAMMER", "ISLAND", "JUNGLE", "KETTLE", "LIZARD", "METEOR",
            "STARDUST", "QUARTZ", "ODYSSEY", "PHANTOM", "VALLEY", "CANYON", "OASIS", "LEGACY"
        ];

        const passphraseInput = document.getElementById('passphrase');
        const toggleBtn = document.getElementById('toggleVisible');
        const authPanel = document.getElementById('authPanel');
        const emptyState = document.getElementById('emptyState');
        const challengeDisplay = document.getElementById('challengeWord');
        const responseDisplay = document.getElementById('responseWord');
        const timerText = document.getElementById('timerText');
        const progressBar = document.getElementById('progressBar');

        function getSeed(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = ((hash << 5) - hash) + str.charCodeAt(i);
                hash |= 0; 
            }
            return Math.abs(hash);
        }

        function updateLogic() {
            const rawSecret = passphraseInput.value;
            
            if (!rawSecret.trim()) {
                authPanel.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }

            authPanel.classList.remove('hidden');
            emptyState.classList.add('hidden');

            const now = Date.now();
            const bucketIndex = Math.floor(now / INTERVAL_MS);
            const msIntoBucket = now % INTERVAL_MS;
            const msRemaining = INTERVAL_MS - msIntoBucket;

            // NORMALIZE: Convert to lowercase and remove all spaces for the seed
            const normalizedSecret = rawSecret.toLowerCase().replace(/\s+/g, '');

            // Generate words using normalized secret + bucketIndex as seed
            const baseSeed = getSeed(normalizedSecret + bucketIndex);
            
            const challengeIndex = baseSeed % words.length;
            const responseIndex = (baseSeed * 31 + 7) % words.length;

            challengeDisplay.textContent = words[challengeIndex];
            responseDisplay.textContent = words[responseIndex];

            const totalSeconds = Math.floor(msRemaining / 1000);
            const mins = Math.floor(totalSeconds / 60);
            const secs = totalSeconds % 60;
            timerText.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            
            const percent = (msRemaining / INTERVAL_MS) * 100;
            progressBar.style.width = `${percent}%`;
        }

        // Visibility toggle logic
        const setVisibility = (visible) => {
            passphraseInput.type = visible ? 'text' : 'password';
        };

        toggleBtn.addEventListener('mousedown', () => setVisibility(true));
        toggleBtn.addEventListener('mouseup', () => setVisibility(false));
        toggleBtn.addEventListener('mouseleave', () => setVisibility(false));
        
        // Touch events for mobile
        toggleBtn.addEventListener('touchstart', (e) => {
            e.preventDefault();
            setVisibility(true);
        });
        toggleBtn.addEventListener('touchend', (e) => {
            e.preventDefault();
            setVisibility(false);
        });

        passphraseInput.addEventListener('input', updateLogic);
        setInterval(updateLogic, 1000);
        updateLogic();
    </script>
</body>
</html>
